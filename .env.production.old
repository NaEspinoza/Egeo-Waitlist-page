# Variables de entorno para producción (Vite)
# Estas variables se inyectan en el build: npm run build

# URL base de PocketBase en producción
# Reemplazar con tu dominio real o IP del contenedor PocketBase
VITE_POCKETBASE_URL=http://pocketbase.ainsophic.com

# Nombre de la colección en PocketBase donde se guardarán los registros
VITE_POCKETBASE_COLLECTION=waitlist
