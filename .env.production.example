# Production environment variables for Vite (do NOT store secrets here)
# Replace the placeholders with your Supabase project values.

# Public Supabase config (ANON key only) - this key is safe to expose to clients
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your_anon_key_here

# Optional: if you still use the backend for emails or other functions
# VITE_API_URL=https://api.yourdomain.com
